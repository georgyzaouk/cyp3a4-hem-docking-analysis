npts 50 50 50                        # num.grid points in xyz
gridfld 1w0e.maps.fld                # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N OA SA        # receptor atom types
ligand_types A C Fe OA N             # ligand atom types
receptor 1w0e.pdbqt                  # macromolecule
gridcenter 58.562 77.922 14.185      # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 1w0e.A.map                       # atom-specific affinity map
map 1w0e.C.map                       # atom-specific affinity map
map 1w0e.Fe.map                      # atom-specific affinity map
map 1w0e.OA.map                      # atom-specific affinity map
map 1w0e.N.map                       # atom-specific affinity map
elecmap 1w0e.e.map                   # electrostatic potential map
dsolvmap 1w0e.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
